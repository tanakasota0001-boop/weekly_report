# Google Gemini API Key
# https://aistudio.google.com/ で無料取得可能
GEMINI_API_KEY=your_gemini_api_key_here

# Gmail送信設定（notification.channel: "gmail" を使用する場合）
# GMAIL_USER: あなたのGoogleメールアドレス
# GMAIL_APP_PASSWORD: Googleアカウントの「セキュリティ」->「2段階認証」->「アプリ パスワード」で生成した16文字のキー
GMAIL_USER=your_name@gmail.com
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# Microsoft Teams Incoming Webhook URL
# Teamsのチャネル設定 -> コネクタ または ワークフロー -> 「Webhook を受信したときにチャネルに投稿する」で取得
TEAMS_WEBHOOK_URL=your_teams_webhook_url_here
